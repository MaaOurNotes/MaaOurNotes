{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaOurNotes",
    "label": "MaaOurNotes",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "CONTACT",
    "license": "LICENSE",
    "welcome": "首次使用！欢迎使用 MAA!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/kazenohane/MaaOurNotes",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaOurNotes",
    // "mirrorchyan_multiplatform": true,
    "languages": {
        "zh_cn": "./locales/zh_cn.json",
        "en_us": "./locales/en_us.json"
    },
    "controller": [
        {
            "name": "Adb",
            "label": "$Controller.Adb",
            "description": "$Controller.Adb.Description",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "国际服-中文",
            "label": "$Resource.GlobalCn",
            "path": [
                "./resource"
            ]
        }
        /*
        {
            "name": "国际服-日文",
            "label": "$Resource.GlobalJp",
            "path": [
                "./resource/base",
                "./resource/global_jp"
            ]
        }*/
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "group": [
        {
            "name": "daily",
            "label": "$Group.Daily"
        },
        {
            "name": "standalone",
            "label": "$Group.Standalone"
        }
    ],
    "import": [
        "./interface/presets/daily.json",
        "./interface/tasks/start_up.json",
        "./interface/tasks/collect_rewards.json",
        "./interface/tasks/loop_live.json"
    ]
}