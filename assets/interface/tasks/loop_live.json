{
    "task": [
        {
            "name": "挂机演出",
            "label": "$Task.LoopLive",
            "entry": "LoopLive",
            "group": [
                "standalone"
            ],
            "option": [
                "演出歌曲",
                "演出次数"
            ]
        },
        {
            "name": "自动演出(仅简单)",
            "label": "$Task.PerformLive",
            "entry": "LoopLive",
            "group": [
                "standalone"
            ],
            "option": [
                "自动演出歌曲",
                "演出次数",
                "自动清火"
            ],
            "pipeline_override": {
                "LoopLiveStart": {
                    "next": [
                        "LoopLivePerform"
                    ],
                    "post_delay": 3000,
                    "rate_limit": 0
                }
            }
        }
    ],
    "option": {
        "演出歌曲": {
            "label": "$Option.LoopLive.SelectSong",
            "type": "select",
            "default_case": "unravel",
            "cases": [
                {
                    "name": "六兆年と一夜物語",
                    "label": "六兆年と一夜物語",
                    "pipeline_override": {
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "六兆年と一夜物語"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "翻唱"
                        },
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/MewType.png"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectExpert"
                        }
                    }
                },
                {
                    "name": "unravel",
                    "label": "unravel",
                    "pipeline_override": {
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/millsage.png"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "翻唱"
                        },
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "unravel"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectExpert"
                        }
                    }
                },
                {
                    "name": "Ave Mujica",
                    "label": "Ave Mujica",
                    "pipeline_override": {
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/AveMujica.png"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "原创"
                        },
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "Ave Mujica"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectExpert"
                        }
                    }
                }
            ]
        },
        "演出次数": {
            "type": "input",
            "label": "$Option.LoopLiveCount",
            "inputs": [
                {
                    "name": "演出次数",
                    "label": "$Option.LoopLiveCount.Input",
                    "pipeline_type": "int",
                    "default": "3",
                    "verify": "^(0|[1-9]\\d*)$"
                }
            ],
            "pipeline_override": {
                "LoopLiveCount": {
                    "max_hit": "{演出次数}"
                }
            },
            "description": "设置挂机演出次数"
        },
        "自动演出歌曲": {
            "label": "$Option.LoopLive.SelectSong",
            "type": "select",
            "default_case": "unravel · easy",
            "cases": [
                {
                    "name": "unravel · hard",
                    "label": "unravel · hard",
                    "pipeline_override": {
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/millsage.png"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "翻唱"
                        },
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "unravel"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectHard"
                        },
                        "LoopLivePerform": {
                            "custom_action_param": {
                                "song": "unravel",
                                "difficulty": "hard"
                            }
                        }
                    }
                },
                {
                    "name": "unravel · easy",
                    "label": "unravel · easy",
                    "pipeline_override": {
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/millsage.png"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "翻唱"
                        },
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "unravel"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectEasy"
                        },
                        "LoopLivePerform": {
                            "custom_action_param": {
                                "song": "unravel",
                                "difficulty": "easy"
                            }
                        }
                    }
                },
                {
                    "name": "六兆年と一夜物語 · easy",
                    "label": "六兆年と一夜物語 · easy",
                    "pipeline_override": {
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "六兆年と一夜物語"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "翻唱"
                        },
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/MewType.png"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectEasy"
                        },
                        "LoopLivePerform": {
                            "custom_action_param": {
                                "song": "六兆年と一夜物語",
                                "difficulty": "easy"
                            }
                        }
                    }
                },
                {
                    "name": "Ave Mujica · easy",
                    "label": "Ave Mujica · easy",
                    "pipeline_override": {
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/AveMujica.png"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "原创"
                        },
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "Ave Mujica"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectEasy"
                        },
                        "LoopLivePerform": {
                            "custom_action_param": {
                                "song": "Ave Mujica",
                                "difficulty": "easy"
                            }
                        }
                    }
                },
                {
                    "name": "Ave Mujica · expert",
                    "label": "Ave Mujica · expert",
                    "pipeline_override": {
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/AveMujica.png"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "原创"
                        },
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "Ave Mujica"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectExpert"
                        },
                        "LoopLivePerform": {
                            "custom_action_param": {
                                "song": "Ave Mujica",
                                "difficulty": "expert"
                            }
                        }
                    }
                }
            ]
        },
        "自动清火": {
            "label": "$Option.LoopLive.UseLiveBoost",
            "type": "select",
            "default_case": "19",
            "cases": [
                {
                    "name": "19",
                    "label": "19",
                    "pipeline_override": {
                        "LoopLiveCheckLiveBoost": {
                            "expected": "19|2[0-9]"
                        }
                    }
                },
                {
                    "name": "14",
                    "label": "14",
                    "pipeline_override": {
                        "LoopLiveCheckLiveBoost": {
                            "expected": "14|1[5-9]|2[0-9]"
                        }
                    }
                },
                {
                    "name": "9",
                    "label": "9",
                    "pipeline_override": {
                        "LoopLiveCheckLiveBoost": {
                            "expected": "9|1[0-9]|2[0-9]"
                        }
                    }
                }
            ]
        }
    }
}
