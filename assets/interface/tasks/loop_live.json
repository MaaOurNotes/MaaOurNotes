        "触发清火": {
            "description": "$Option.LoopLive.UseLiveBoost.Description",
            "label": "$Option.LoopLive.UseLiveBoost",
            "type": "select",
            "default_case": "启用",
            "cases": [
                {
                    "name": "启用",
                    "label": "$Option.LoopLive.UseLiveBoost.Enabled",
                    "option": [
                        "清火阈值"
                    ],
                    "pipeline_override": {
                        "LoopLiveCheckLiveBoost": {
                            "enabled": true
                        },
                        "CheckFirePeriodically": {
                            "enabled": true
                        },
                        "UseLiveBoostWhenFull": {
                            "next": [
                                "[JumpBack]BackToMain",
                                "CheckFirePeriodically"
                            ]
                        }
                    }
                },
                {
                    "name": "不使用",
                    "label": "$Option.LoopLive.UseLiveBoost.Disabled",
                    "pipeline_override": {
                        "LoopLiveCheckLiveBoost": {
                            "enabled": false
                        },
                        "CheckFirePeriodically": {
                            "enabled": false
                        },
                        "UseLiveBoostWhenFull": {
                            "next": [
                                "[JumpBack]BackToMain",
                                "LoopLiveEnd"
                            ]
                        }
                    }
                }
            ]
        },
        "清火阈值": {
            "type": "input",
            "label": "$Option.LoopLive.UseLiveBoost.Threshold",
            "description": "$Option.LoopLive.UseLiveBoost.Description",
            "inputs": [
                {
                    "name": "清火阈值",
                    "label": "$Option.LoopLive.UseLiveBoost.Threshold",
                    "pipeline_type": "int",
                    "default": "18",
                    "verify": "^(0|[1-9]\\d*)$"
                }
            ],
            "pipeline_override": {
                "LoopLiveCheckLiveBoost": {
                    "custom_recognition_param": {
                        "threshold": "{清火阈值}",
                        "roi": [
                            1044,
                            23,
                            27,
                            25
                        ]
                    }
                },
                "CheckFirePeriodically": {
                    "custom_recognition_param": {
                        "threshold": "{清火阈值}",
                        "roi": [
                            424,
                            34,
                            24,
                            21
                        ]
                    }
                }
            }
        },
        "是否挂机": {
            "description": "$Option.LoopLive.UseAFK.Description",
            "label": "$Option.LoopLive.UseAFK",
            "type": "select",
            "default_case": "是",
            "cases": [
                {
                    "name": "是",
                    "label": "$Option.LoopLive.UseAFK.Yes",
                    "pipeline_override": {
                        "LoopLiveStart": {
                            "next": [
                                "LoopLiveFinish"
                            ],
                            "post_delay": 90000,
                            "rate_limit": 2000
                        }
                    }
                },
                {
                    "name": "否",
                    "label": "$Option.LoopLive.UseAFK.No",
                    "pipeline_override": {
                        "LoopLiveStart": {
                            "next": [
                                "LoopLivePerform"
                            ],
                            "post_delay": 3000,
                            "rate_limit": 0
                        }
                    }
                }
            ]
        }
    }
}