{
    "task": [
        {
            "name": "自动清火",
            "label": "$Task.UseFire",
            "entry": "UseLiveBoostWhenFull",
            "group": [
                "standalone"
            ],
            "option": [
                "触发清火",
                "是否挂机",
                "自动演出歌曲"
            ]
        },
        {
            "name": "挂机演出",
            "label": "$Task.LoopLive",
            "entry": "LoopLive",
            "group": [
                "standalone"
            ],
            "option": [
                "演出歌曲",
                "演出次数",
                "触发清火"
            ]
        },
        {
            "name": "自动演出",
            "label": "$Task.PerformLive",
            "entry": "LoopLive",
            "group": [
                "standalone"
            ],
            "option": [
                "自动演出歌曲",
                "演出次数",
                "触发清火"
            ],
            "pipeline_override": {
                "LoopLiveStart": {
                    "next": [
                        "LoopLivePerform"
                    ],
                    "post_delay": 3000,
                    "rate_limit": 0
                }
            }
        }
    ],
    "option": {
        "演出歌曲": {
            "label": "$Option.LoopLive.SelectSong",
            "type": "select",
            "default_case": "unravel",
            "cases": [
                {
                    "name": "Ave Mujica",
                    "label": "Ave Mujica·expert·Ave Mujica",
                    "pipeline_override": {
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/AveMujica.png"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "原创"
                        },
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "Ave Mujica"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectExpert"
                        }
                    }
                },
                {
                    "name": "unravel",
                    "label": "unravel·expert·millsage",
                    "pipeline_override": {
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/millsage.png"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "翻唱"
                        },
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "unravel"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectExpert"
                        }
                    }
                },
                {
                    "name": "六兆年と一夜物語",
                    "label": "六兆年と一夜物語·expert·梦限大MewType",
                    "pipeline_override": {
                        "LoopLiveSelectSong": {
                            "recognition": "OCR",
                            "expected": "六兆年と一夜物語"
                        },
                        "LoopLiveSelectType": {
                            "recognition": "OCR",
                            "expected": "翻唱"
                        },
                        "LoopLiveSelectBand": {
                            "recognition": "TemplateMatch",
                            "template": "Live/MewType.png"
                        },
                        "LoopLiveSelectDifficulty": {
                            "next": "LoopLiveSelectExpert"
                        }
                    }
                }
            ]
        },
        "演出次数": {
            "type": "input",
            "label": "$Option.LoopLiveCount",
            "inputs": [
                {
                    "name": "演出次数",
                    "label": "$Option.LoopLiveCount.Input",
                    "pipeline_type": "int",
                    "default": "3",
                    "verify": "^(0|[1-9]\\d*)$"
                }
            ],
            "pipeline_override": {
                "LoopLiveCount": {
                    "max_hit": "{演出次数}"
                }
            },
            "description": "$Option.LoopLiveCount.Description"
        },
        "自动演出歌曲": {
